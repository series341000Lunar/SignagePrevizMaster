{
  "manifestVersion": 5,
  "id": "com.luux.signagepreviz.livelink",
  "name": "LUUX Live Link",
  "version": "0.7.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.3.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "luuxLiveLinkPanel",
      "label": {
        "default": "LUUX Live Link"
      },
      "minimumSize": {
        "width": 240,
        "height": 320
      },
      "maximumSize": {
        "width": 1200,
        "height": 1600
      },
      "preferredDockedSize": {
        "width": 280,
        "height": 560
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 620
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "ws://localhost/"
      ]
    }
  }
}
